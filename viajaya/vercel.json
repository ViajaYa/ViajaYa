{
    "rewrites": [
        {
            "source": "/user/:path*",
            "destination": "https://viajaya-mve8.onrender.com/user/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "https://viajaya-mve8.onrender.com/auth/:path*"
        },
        {
            "source": "/financial/:path*",
            "destination": "https://viajaya-mve8.onrender.com/financial/:path*"
        },
        {
            "source": "/commissions/:path*",
            "destination": "https://viajaya-mve8.onrender.com/commissions/:path*"
        },
        {
            "source": "/quotes/:path*",
            "destination": "https://viajaya-mve8.onrender.com/quotes/:path*"
        },
        {
            "source": "/quote-calculations/:path*",
            "destination": "https://viajaya-mve8.onrender.com/quote-calculations/:path*"
        },
        {
            "source": "/passengers/:path*",
            "destination": "https://viajaya-mve8.onrender.com/passengers/:path*"
        },
        {
            "source": "/contracts/:path*",
            "destination": "https://viajaya-mve8.onrender.com/contracts/:path*"
        },
        {
            "source": "/pack/:path*",
            "destination": "https://viajaya-mve8.onrender.com/pack/:path*"
        },
        {
            "source": "/purchases/:path*",
            "destination": "https://viajaya-mve8.onrender.com/purchases/:path*"
        },
        {
            "source": "/payments/:path*",
            "destination": "https://viajaya-mve8.onrender.com/payments/:path*"
        },
        {
            "source": "/promotions/:path*",
            "destination": "https://viajaya-mve8.onrender.com/promotions/:path*"
        },
        {
            "source": "/configs/:path*",
            "destination": "https://viajaya-mve8.onrender.com/configs/:path*"
        },
        {
            "source": "/dashboard/:path*",
            "destination": "https://viajaya-mve8.onrender.com/dashboard/:path*"
        },
        {
            "source": "/admin/:path*",
            "destination": "https://viajaya-mve8.onrender.com/admin/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://viajaya-mve8.onrender.com/uploads/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(user|auth|financial|commissions|quotes|quote-calculations|packages|purchases|payments|promotions|configs|dashboard|admin|uploads|passengers|contracts)/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Credentials", "value": "true" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
                { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
            ]
        }
    ]
}